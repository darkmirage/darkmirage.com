{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "bg", "name": "Page", "color": "var(--dm-bg)" },
				{ "slug": "surface", "name": "Surface", "color": "var(--dm-surface)" },
				{ "slug": "line", "name": "Line", "color": "var(--dm-line)" },
				{ "slug": "fg", "name": "Heading", "color": "var(--dm-fg)" },
				{ "slug": "body", "name": "Body text", "color": "var(--dm-body)" },
				{ "slug": "muted", "name": "Muted", "color": "var(--dm-muted)" },
				{ "slug": "accent", "name": "Spice", "color": "var(--dm-accent)" },
				{ "slug": "brigade", "name": "Brigade red", "color": "var(--dm-brigade)" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "2.25rem" },
				{ "slug": "50", "name": "XL", "size": "3.5rem" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "X-Large", "size": "2.125rem", "fluid": { "min": "1.625rem", "max": "2.125rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "3.75rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } }
			],
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Chakra Petch",
					"fontFamily": "\"Chakra Petch\", \"Chakra Petch Fallback\", \"Avenir Next\", \"Hiragino Sans\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Chakra Petch", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "block", "src": [ "file:./assets/fonts/chakra-petch-latin-500-normal.woff2" ] },
						{ "fontFamily": "Chakra Petch", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "block", "src": [ "file:./assets/fonts/chakra-petch-latin-600-normal.woff2" ] }
					]
				},
				{
					"slug": "body",
					"name": "System (with Japanese)",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Yu Gothic\", Meiryo, sans-serif"
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", \"JetBrains Mono Fallback\", ui-monospace, Menlo, Consolas, monospace",
					"fontFace": [
						{ "fontFamily": "JetBrains Mono", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "block", "src": [ "file:./assets/fonts/jetbrains-mono-latin-400-normal.woff2" ] },
						{ "fontFamily": "JetBrains Mono", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "block", "src": [ "file:./assets/fonts/jetbrains-mono-latin-500-normal.woff2" ] }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|bg", "text": "var:preset|color|body" },
		"spacing": { "padding": { "left": "clamp(16px, 4vw, 28px)", "right": "clamp(16px, 4vw, 28px)" }, "blockGap": "1.5rem" },
		"typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.8" },
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|fg" },
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600", "lineHeight": "1.15" }
			},
			"link": {
				"color": { "text": "var:preset|color|accent" },
				":hover": { "color": { "text": "var:preset|color|fg" } }
			},
			"button": {
				"color": { "background": "var:preset|color|accent", "text": "var:preset|color|bg" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "600" }
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/post-title": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|accent", "width": "3px" } },
				"spacing": { "padding": { "left": "1.25rem" } }
			},
			"core/code": { "typography": { "fontFamily": "var:preset|font-family|mono" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-archives", "title": "Archive index", "postTypes": [ "page" ] },
		{ "name": "page-tag", "title": "Tag index", "postTypes": [ "page" ] }
	]
}
