# htaccess file version 1.4.12;
# Zenphoto 1.6.8 for gallery.darkmirage.com (subdomain docroot, so RewriteBase /).
# Rewrite rules are handled by Zenphoto's PHP code (zp-core/rewrite-rules.txt);
# these rules send everything that isn't a real file to index.php.
#
# The "Legacy" block keeps Zenphoto 1.2 image URLs working; ~1,200 blog posts embed them.
# Image pages (/<album>/<file>.jpg) need no rule: Zenphoto serves them natively because
# the mod_rewrite image suffix option is empty. Keep it empty.

<IfModule mod_autoindex.c>
	IndexIgnore *
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Legacy Zenphoto 1.2 URLs ---
  # Resized image: /<album>/image/<400|800|thumb>/<file>
  RewriteRule ^(.+)/image/(thumb|[0-9]+)/([^/]+)$   zp-core/i.php?a=$1&i=$3&s=$2 [L,QSA]
  # Full-size image: /<album>/image/<file>
  RewriteRule ^(.+)/image/([^/]+)$                  albums/$1/$2 [L]
  # Cached resize hot-linked by posts: /cache/<album>/<file>_<size>.jpg. Serve the cached file if it
  # exists, otherwise let i.php make it (it writes the same cache path).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cache/(.+)/([^/]+\.(?:jpe?g|png|gif))_([0-9]+)\.(?:jpe?g|png|gif)$   zp-core/i.php?a=$1&i=$2&s=$3 [L,QSA,NC]
  # --- End legacy ---

  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule (.*) %{REQUEST_URI}/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^.*$ - [L]
  RewriteRule ^.*/?$                        index.php [L,QSA]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
