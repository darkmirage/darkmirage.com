# htaccess file version 1.4.12;
# Zenphoto 1.6.8 for gallery.darkmirage.com (subdomain docroot, so RewriteBase /).
# Rewrite rules are handled by Zenphoto's PHP code (zp-core/rewrite-rules.txt);
# these rules send everything that isn't a real file to index.php.
#
# The "Legacy" block keeps Zenphoto 1.2 image URLs working; ~1,200 blog posts embed them.
# Image pages (/<album>/<file>.jpg) need no rule: Zenphoto serves them natively because
# the mod_rewrite image suffix option is empty. Keep it empty.

<IfModule mod_autoindex.c>
	IndexIgnore *
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve everything over https (certificate renewals still reach /.well-known/ over http).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Image processor security is off (see below), and Zenphoto's sanitize_path keeps a leading "..",
  # so refuse i.php requests that try to climb out of albums/.
  RewriteCond %{QUERY_STRING} (^|&)(a|i)=[^&]*(\.\.|%2e%2e|\.%2e|%2e\.) [NC]
  RewriteRule ^zp-core/i\.php$ - [F,L]

  # --- Legacy Zenphoto 1.2 URLs ---
  # Only the sizes the blog's posts use (checked 2026-10-19), and no extra query parameters, so these
  # rules can't be used to make i.php render endless new sizes into cache/.
  # Resized image: /<album>/image/<400|450|800|thumb>/<file>
  RewriteRule ^(.+)/image/(thumb|400|450|800)/([^/]+)$   zp-core/i.php?a=$1&i=$3&s=$2 [L]
  # Image page with 1.2's ".php" suffix (228 such links 404ed in Search Console, 2026-10-30): /<album>/<file>.php
  RewriteRule ^(.+\.(?:jpe?g|png|gif))\.php$          /$1 [R=301,L,NC]
  # Full-size image: /<album>/image/<file>
  RewriteRule ^(.+)/image/([^/]+)$                  albums/$1/$2 [L]
  # Cached resize hot-linked by posts: /cache/<album>/<file>_<size>.jpg. Serve the cached file if it
  # exists, otherwise let i.php make it (it writes the same cache path).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cache/(.+)/([^/]+\.(?:jpe?g|png|gif))_(400)\.(?:jpe?g|png|gif)$   zp-core/i.php?a=$1&i=$2&s=$3 [L,NC]
  # --- End legacy ---

  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule (.*) %{REQUEST_URI}/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^.*$ - [L]
  RewriteRule ^.*/?$                        index.php [L,QSA]
</IfModule>


# Browser caching. Photos and their resized copies never change (a re-upload gets a new ?cached=
# stamp), and the theme's CSS is versioned, so readers can keep them; pages themselves stay fresh.
<IfModule mod_headers.c>
	<FilesMatch "\.(?i:jpe?g|png|gif|webp)$">
		Header set Cache-Control "public, max-age=31536000"
	</FilesMatch>
	<FilesMatch "\.(css|js|woff2)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
</IfModule>
